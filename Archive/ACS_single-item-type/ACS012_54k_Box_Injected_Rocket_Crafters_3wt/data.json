  "records": {
    "description": "Rocket crafters that craft at 2x Hs directly into a shulker box. SS14 detection initiates a countdown to break the box as soon as it fills completely, outputting full boxes. Rate: 30box/h.",
    "features": [
      "Clocked at 4gt, crafts 54k rockets/h",
      "Crafts directly into shulker box",
      "Low Inv. shut-off",
      "Box Accessible",
      "Toggless",
      "Tile-able"
    ],
    "considerations": [
      "Does not craft paper from cane, requires paper at input"
    ],
    "instructions": [
      "All crafter inventories have to be prefilled with 1 stack of items for each slot",
      "Place first empty box at output, pre-fill dispenser and dropper in box loader with 1 empty shulker each"
    ],
    "notes": "The crafters can be tiled indefinitely but should be grouped and sequentially tiled, (eg. D111,D222,D333)",
    "compatibility": "Tested in 1.21.11"
  },
